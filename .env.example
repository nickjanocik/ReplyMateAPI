# Supabase supplies these automatically to hosted Edge Functions. Set them locally.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI
# Defaults to live. Set mock explicitly only for deterministic local development without API calls.
OPENAI_MODE=live
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.4-nano
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Comma-separated, exact browser origins. Never use * with authenticated requests.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://127.0.0.1:4173,http://localhost:4173,https://your-app.vercel.app

# --- Stripe billing --------------------------------------------------------
# Required for /v1-billing (checkout + portal) and /v1-billing-webhook.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint pointed at
# <SUPABASE_URL>/functions/v1/v1-billing-webhook. Subscribe it to
# checkout.session.completed and customer.subscription.{created,updated,deleted}.
STRIPE_WEBHOOK_SECRET=

# Where to send a customer back to when the request has no Origin header.
# Only needed for non-browser callers; browser calls use the (CORS-validated)
# Origin. Must be an exact origin, no trailing slash.
APP_BASE_URL=

# Prices are normally found by lookup key (replymate_<plan>_<monthly|annual>),
# created by `deno run -A scripts/stripe_setup.ts`. Set these only to pin a
# deployment to specific price ids, e.g. throwaway prices in staging.
# STRIPE_PRICE_STARTER_MONTHLY=
# STRIPE_PRICE_STARTER_ANNUAL=
# STRIPE_PRICE_GROWTH_MONTHLY=
# STRIPE_PRICE_GROWTH_ANNUAL=
# STRIPE_PRICE_SCALE_MONTHLY=
# STRIPE_PRICE_SCALE_ANNUAL=

# Twilio messaging scaffold
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
MESSAGING_MODE=mock

# --- LLM provider -----------------------------------------------------------
# openai (default) or gemini. Chat generation only; embeddings always use
# OPENAI_EMBEDDING_MODEL because knowledge_chunks.embedding is vector(1536).
LLM_PROVIDER=openai
GEMINI_API_KEY=
# Verified ids: gemini-3.1-flash-lite, gemini-3.5-flash, gemini-3.5-flash-lite,
# gemini-3.6-flash. There is no plain "gemini-3.1-flash".
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite
# Per-million-token rates for usage estimates. Unset means estimates report 0.
GEMINI_INPUT_PRICE_PER_MTOK=
GEMINI_OUTPUT_PRICE_PER_MTOK=
GEMINI_CACHED_INPUT_PRICE_PER_MTOK=
