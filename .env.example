# Supabase supplies these automatically to hosted Edge Functions. Set them locally.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.4-nano
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Comma-separated, exact browser origins. Never use * with authenticated requests.
ALLOWED_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# Stripe billing scaffold
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Twilio messaging scaffold
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
MESSAGING_MODE=mock

